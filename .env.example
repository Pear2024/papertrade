# =============================================================================
# Paper Crypto Coach — Environment Variables (copy to .env)
# DO NOT commit real secrets to Git.
# =============================================================================

# --- MySQL ---
MYSQL_DATABASE=paper_crypto_coach
MYSQL_USER=paper_user
MYSQL_PASSWORD=change_me_paper_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# SQLAlchemy / FastAPI connection string
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://paper_user:change_me_paper_password@db:3306/paper_crypto_coach

# --- Auth (JWT) ---
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_MINUTES=1440

# --- Paper trading ---
# Flat USD fee per paper fill (preferred). Set to 0 to use percent instead.
PAPER_TRADING_FEE_USD=9
PAPER_TRADING_FEE_PERCENT=0.05
PAPER_STARTING_BALANCE=20000.00

# --- Public price API (no secret key required) ---
PUBLIC_PRICE_API_URL=https://api.coingecko.com/api/v3
# Kraken PUBLIC market data only — DO NOT put API keys here
KRAKEN_REST_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_FEED_ENABLED=true

# --- FastAPI ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3001

# --- Next.js ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NODE_ENV=development

# --- Google Chat (optional coach BUY/SELL alerts in Thai) ---
# Incoming webhook URL from Google Chat space. Leave empty to disable.
GOOGLE_CHAT_WEBHOOK_URL=

# --- MetaAlpha Quantum Engine (optional ENTRY filter; default OFF) ---
# Requires apps/api/requirements-ml.txt when enabled. Without a joblib artifact,
# enabled+fail-closed skips ENTRY opens (does not change SL/TP/$TP exits).
META_ALPHA_ENABLED=false
META_ALPHA_THRESHOLD=0.75
META_ALPHA_MODEL_PATH=apps/api/app/services/meta_alpha/artifacts/meta_labeler.joblib
META_ALPHA_MODE=feature
META_ALPHA_FAIL_CLOSED=true
META_ALPHA_MIN_BARS=120
